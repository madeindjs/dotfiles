#!/bin/bash
set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: $0 <video> [speed]"
    echo "  speed: ralenti, ex: 0.25 (défaut), 0.5, 0.75..."
    echo "  Sortie: input.x0.25.mp4"
    echo "  L'audio est ralenti façon bande magnétique (le pitch descend"
    echo "  avec la vitesse, sans time-stretching). Correspond à MPV avec"
    echo "  audio-pitch-correction=no."
    exit 1
fi

INPUT="$1"
SPEED="${2:-0.25}"

if [ ! -f "$INPUT" ]; then
    echo "Fichier introuvable: $INPUT"
    exit 1
fi

BASE="${INPUT%.*}"
EXT="${INPUT##*.}"
OUTPUT="${BASE}.x${SPEED}.${EXT}"

# Fréquence de travail; l'audio source est resamplé à cette valeur.
RATE=44100
# asetrate change la fréquence déclarée sans toucher aux échantillons,
# aresample reconvertit à RATE: la durée est multipliée par 1/SPEED et
# le pitch descend d'autant (effet bande magnétique).
ASET=$(awk "BEGIN { printf \"%d\", $RATE * $SPEED }")
FACTOR=$(awk "BEGIN { printf \"%.6f\", 1/$SPEED }")

echo "Input:  $INPUT"
echo "Output: $OUTPUT"
echo "Speed:  x${SPEED}"

echo "→ Assemblage final..."
ffmpeg -i "$INPUT" \
    -filter:v "setpts=${FACTOR}*PTS" \
    -filter:a "aresample=${RATE},asetrate=${ASET},aresample=${RATE}" \
    -c:v libx264 -crf 18 -preset medium \
    -c:a aac -b:a 192k \
    -shortest \
    -y "$OUTPUT" -loglevel warning

echo "✓ $OUTPUT"